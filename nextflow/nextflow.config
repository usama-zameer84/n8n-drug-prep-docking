// Nextflow config for Ligand Docking Workbench.
// Profiles: standard (default, local + conda), conda, slurm (stub), awsbatch (stub), test.

manifest {
    name        = 'ligand-docking-workbench'
    description = 'Ligand preparation, receptor selection, AutoDock Vina docking, reports, and structural MD handoff'
    author      = 'Usama Zameer'
    mainScript  = 'main.nf'
    version     = '1.0.0'
    nextflowVersion = '!>=24.04.0'
}

// Default parameters. Override on the CLI: --input nextflow/examples/input.smi --exhaustiveness 32
params {
    input              = "${projectDir}/examples/input.smi"
    outdir             = "${launchDir}/results"
    receptor_selection_mode = 'auto'   // 'auto' or 'provided'
    pdb_id             = ''
    chain_ids          = ''
    center_x           = null
    center_y           = null
    center_z           = null
    size_x             = 20
    size_y             = 20
    size_z             = 20
    ph                 = 7.4
    exhaustiveness     = 8
    num_modes          = 9
    energy_range       = 3
    seed               = 20260824
    cpu                = 1
    replicas           = 1
    timeout_seconds    = 900
    cutoff             = 4.5
    target_organism    = 'Homo sapiens'
    target_similarity_threshold = 70
    target_candidate_limit      = 5
    heterogen_policy   = 'remove_all'
    add_missing_residues = false
    allow_multicomponent  = false
    publish_mode       = 'copy'
}

// Base process defaults.
process {
    executor   = 'local'
    cpus       = 1
    memory     = '2 GB'
    time       = '30m'
    errorStrategy = 'terminate'
    maxRetries    = 0
    // conda env built from the shared scientific pins (rdkit, openmm, pdbfixer, vina, meeko)
    conda      = "${projectDir}/../environment.yml"
    // stage the bin/ helpers and lib/ into every task work dir
    stageInMode = 'copy'
}

profiles {
    standard {
        // default: local executor + a Nextflow-managed conda env
        conda.enabled = true
    }
    local {
        // use the conda env already activated in the launching shell (e.g. `conda activate drugprep`).
        // skips Nextflow's own env provisioning, so first-run is fast. Requires the scientific
        // stack (rdkit, openmm, pdbfixer, vina, meeko) + the vina binary on PATH in that shell.
        process.conda = null
        process.executor = 'local'
        conda.enabled = false
    }
    conda {
        process.conda = "${projectDir}/../environment.yml"
        process.executor = 'local'
        conda.enabled = true
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'long'
        conda.enabled    = true
        // Per-process resource directives remain authoritative. Adjust them with withName
        // selectors in a site config when the cluster requires different limits.
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.conda    = null
        process.queue    = 'nextflow-queue'
        // cloud note: replace with a container image; conda provisioning is not available on AWS Batch.
    }
    test {
        params.input        = "${projectDir}/examples/input.test.smi"
        params.exhaustiveness = 8
        params.replicas    = 1
        params.cpu         = 1
        params.timeout_seconds = 300
    }
}

// Keep the work cache for reproducible `-resume`; users can run `nextflow clean` explicitly.
